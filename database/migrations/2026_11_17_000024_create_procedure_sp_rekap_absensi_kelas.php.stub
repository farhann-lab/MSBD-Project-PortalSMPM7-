CREATE PROCEDURE `sp_rekap_absensi_kelas`(IN p_id_kelas INT,IN p_awal DATE,IN p_akhir DATE)
SQL SECURITY DEFINER READS SQL DATA
BEGIN
    IF p_awal IS NULL OR p_akhir IS NULL OR p_awal>p_akhir THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Rentang tanggal rekap tidak valid';
