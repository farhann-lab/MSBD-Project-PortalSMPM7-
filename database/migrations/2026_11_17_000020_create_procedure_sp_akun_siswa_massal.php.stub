    IF v_lock IS NULL OR v_lock<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Pembuatan akun massal sedang berlangsung'; END IF;
    START TRANSACTION;
    SELECT COUNT(*),MAX(tahun) INTO v_naktif,v_tasm
      FROM tahun WHERE aktif='Y' AND tahun REGEXP '^[0-9]{4}[12]$';
    IF v_naktif<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Harus ada tepat satu periode aktif'; END IF;
