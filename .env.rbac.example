# Tambahkan ke .env SIAKAD (bukan .env kating). Jangan commit file .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siakad_rkm
# DB_USERNAME / DB_PASSWORD khusus migrasi/maintenance, bukan untuk website.

# Aktifkan menjadi true HANYA setelah lima akun MySQL dan grants lulus tes.
SIAKAD_RBAC_ENABLED=false
DB_AUTH_USERNAME=siakad_auth_user
DB_AUTH_PASSWORD=
DB_ADMIN_USERNAME=siakad_admin_user
DB_ADMIN_PASSWORD=
DB_GURU_USERNAME=siakad_guru_user
DB_GURU_PASSWORD=
DB_SISWA_USERNAME=siakad_siswa_user
DB_SISWA_PASSWORD=
DB_PUBLIC_USERNAME=siakad_public_user
DB_PUBLIC_PASSWORD=

# Hindari penulisan session/cache/job memakai akun role yang tidak berhak.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
