                           (target.id_kelas=w.id_kelas OR target.id_guru=w.id_guru));
    SET v_jumlah=ROW_COUNT();
    COMMIT;
    DO RELEASE_LOCK(v_nama_lock);
    SELECT v_jumlah AS jumlah_disalin;
END
SIAKAD_SQL_TEXT
