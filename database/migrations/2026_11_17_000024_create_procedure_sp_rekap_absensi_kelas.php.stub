    JOIN siakad_jadwal j ON j.id=p.jadwal_id
    JOIN t_guru_mapel gm ON gm.id=j.id_guru_mapel
    WHERE gm.id_kelas=p_id_kelas AND p.tanggal BETWEEN p_awal AND p_akhir
      AND fn_kelas_siswa(a.id_siswa,fn_ta_dari_tasm(j.tasm))=p_id_kelas
    GROUP BY a.id_siswa,s.nama ORDER BY s.nama;
END
