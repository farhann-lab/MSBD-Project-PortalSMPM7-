           username VARCHAR(100) PATH '$.username' NULL ON EMPTY NULL ON ERROR,
           hash_bcrypt VARCHAR(255) PATH '$.hash' NULL ON EMPTY NULL ON ERROR
         )) AS x
    JOIN m_siswa s ON s.id=x.id_siswa
    WHERE x.id_siswa>0 AND x.username IS NOT NULL AND TRIM(x.username)<>''
      AND x.username <> '0' AND BINARY x.username = BINARY s.nis
      AND s.nis NOT IN ('','0')
      AND x.hash_bcrypt IS NOT NULL AND CHAR_LENGTH(x.hash_bcrypt)=60
      AND LEFT(x.hash_bcrypt,4) IN ('$2y$','$2b$','$2a$')
