# Tambahkan ke .env SIAKAD (bukan .env kating). Jangan commit file .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siakad_rkm
# DB_USERNAME / DB_PASSWORD khusus migrasi/maintenance, bukan untuk website.

# Aktifkan menjadi true HANYA setelah lima akun MySQL dan grants lulus tes.
SIAKAD_RBAC_ENABLED=false
DB_AUTH_USERNAME=siakad_auth_user
DB_AUTH_PASSWORD=
DB_ADMIN_USERNAME=siakad_admin_user
DB_ADMIN_PASSWORD=
DB_GURU_USERNAME=siakad_guru_user
DB_GURU_PASSWORD=
DB_SISWA_USERNAME=siakad_siswa_user
DB_SISWA_PASSWORD=
DB_PUBLIC_USERNAME=siakad_public_user
DB_PUBLIC_PASSWORD=

# Hindari penulisan session/cache/job memakai akun role yang tidak berhak.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync


APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:+R9SVJIyFUvCY94wJnibjYsE22+O6YixFMtCwuP1HAI=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
