CREATE PROCEDURE `sp_salin_walikelas`(IN p_asal VARCHAR(5),IN p_tujuan VARCHAR(5))
SQL SECURITY DEFINER MODIFIES SQL DATA
BEGIN
    DECLARE v_lock INT DEFAULT 0;
    DECLARE v_nama_lock VARCHAR(64);
    DECLARE v_jumlah INT DEFAULT 0;
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        IF v_lock=1 THEN DO RELEASE_LOCK(v_nama_lock); END IF;
        RESIGNAL;
    END;
    IF p_asal IS NULL OR p_tujuan IS NULL OR p_asal=p_tujuan OR
       p_asal NOT REGEXP '^[0-9]{4}[12]$' OR p_tujuan NOT REGEXP '^[0-9]{4}[12]$' THEN
