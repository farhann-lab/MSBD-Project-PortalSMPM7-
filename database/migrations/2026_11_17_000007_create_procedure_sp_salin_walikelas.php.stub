    END IF;
    SET v_nama_lock=CONCAT('siakad:walikelas:',p_tujuan);
    SELECT GET_LOCK(v_nama_lock,5) INTO v_lock;
    IF v_lock IS NULL OR v_lock<>1 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Lock wali kelas tujuan sibuk'; END IF;
    START TRANSACTION;
    IF EXISTS (SELECT 1 FROM t_walikelas
               WHERE tasm=p_asal AND id_kelas IS NOT NULL
               GROUP BY id_kelas HAVING COUNT(*)>1) OR
       EXISTS (SELECT 1 FROM t_walikelas
               WHERE tasm=p_asal AND id_guru IS NOT NULL
               GROUP BY id_guru HAVING COUNT(*)>1) THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Wali kelas periode asal duplikat, salin dibatalkan';
    END IF;
    INSERT INTO t_walikelas(tasm,id_guru,id_kelas)
